<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1e1e1e"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <TextView
        android:id="@+id/safe_import_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:textColor="#e0e0e0"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/safe_import_log_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <TextView
            android:id="@+id/safe_import_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:textColor="#dcdcdc"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#3a3a3a" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#252525"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/safe_import_exit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#3a3a3a"
            android:minWidth="120dp"
            android:text="@string/safe_import_exit"
            android:textAllCaps="false"
            android:textColor="#e0e0e0" />

        <org.godotengine.editor.SafeImportSpinner
            android:id="@+id/safe_import_spinner"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/safe_import_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="0"
                android:progressTint="#4f9cf9" />

            <TextView
                android:id="@+id/safe_import_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#a0a0a0"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/safe_import_reload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#3a3a3a"
            android:minWidth="120dp"
            android:text="@string/safe_import_reload"
            android:textAllCaps="false"
            android:textColor="#e0e0e0" />
    </LinearLayout>

</LinearLayout>
